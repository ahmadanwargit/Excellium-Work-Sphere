NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=8

# Activity monitoring: trusted portal interaction becomes idle after this many
# minutes; heartbeats are batched at this interval (both values are server-set).
ACTIVITY_IDLE_MINUTES=5
ACTIVITY_HEARTBEAT_SECONDS=30

# Persists all workspace records (attendance, invoices, meetings, equipment,
# notifications, settings, and audit history) in Supabase Postgres.
PERSISTENCE_PROVIDER=supabase

# Server-only Supabase credentials. Do not put these in client/.env.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_secret_key
SUPABASE_STORAGE_BUCKET=excellium-uploads
SUPABASE_UPLOAD_MAX_BYTES=10485760
SUPABASE_SIGNED_URL_TTL_SECONDS=300
